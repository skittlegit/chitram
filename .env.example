# Create an API Read Access Token at https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Optional alternative to TMDB_API_TOKEN.
TMDB_API_KEY=

# Optional canonical deployment URL used for metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret that scrambles the daily answer order. Set a long random value in
# production; without it a public development key is used.
DAILY_SECRET=
